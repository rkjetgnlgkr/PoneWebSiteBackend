<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.pone.website.mapper.LayoutConfigMapper">

    <resultMap id="LayoutConfigResultMap" type="com.pone.website.entity.LayoutConfig">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="themeStyle" column="theme_style"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByUserId" resultMap="LayoutConfigResultMap">
        SELECT id, user_id, theme_style, created_at, updated_at
        FROM layout_config
        WHERE user_id = #{userId}
        LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO layout_config (user_id, theme_style)
        VALUES (#{userId}, #{themeStyle})
    </insert>

    <update id="update">
        UPDATE layout_config
        SET theme_style = #{themeStyle}
        WHERE user_id = #{userId}
    </update>

</mapper>
